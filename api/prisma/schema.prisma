// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//------------------------------------------
//2. Tabela Usuario: Monic, Lara etc
//------------------------------------------

model User{
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      Role      @default(SALES)

  created DateTime @default(now())

  // Relacionamentos
  leads     Lead[]      @relation("LeadOwner") //Leads do usuário
  actions   Contact[]   //Historico de contatos que fez
  imports   ImportBatch[] //Planilhas que importou
}

//------------------------------------------
//3. Planilha importada no sistema
//------------------------------------------

model ImportBatch {
  id          String    @id @default(uuid())
  fileName    String //nome do arquivo, como "leads_fgi.xlsx"
  importedAt  DateTime @default(now())

  //Quem importou
  userId  String
  user    User  @relation(fields: [userId], references: [id])

  //lead gerado
  leads   Lead[]
}

//------------------------------------------
//4. Tabela Lead: empresa prospectada
//------------------------------------------

model Lead {
  id      String @id @default(uuid())

  //Dados que vem da planilha (cadastro)
  cnpj    String? @unique
  companyName String //Razao Social
  cnae        String?
  phone       String?
  email       String?
  city        String?
  state       String?
  address     String?

  funnelStage FunnelStage @default(NEW) //status do funil
  tags        String[]    //Etiquetas
  visitDate   DateTime? //data da visitDate

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  ownerUser   User   @relation("LeadOwner",fields: [ownerId], references: [id])

  //Origem
  ImportBatchId String?
  ImportBatch   ImportBatch? @relation(fields: [ImportBatchId], references: [id])

  // Historico
  contacts      Contact[]
}

//------------------------------------------
//5. Contato (Log)
//------------------------------------------

model Contact{
  id        String @id @default(uuid())
  createdAt DateTime @default(now())

  //ação usuário
  type            ContactType  //Email, ligação
  description     String? //anotação sobre lead feita pelo usuário

  //Identificação usuário
  userId          String
  user            User    @relation(fields: [userId], references: [id])

  //Identificação Lead
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])

  //Alterações
  didChageFunnel  Boolean   @default(false)
  funnelBefore    FunnelStage?
  funnelAfter     FunnelStage?

  didChangeOwner  Boolean   @default(false)
  ownerBeforeId   String?   

  observation     String    //anotar o que ocorreu
}

//------------------------------------------
//6. Tipos de dados
//------------------------------------------

enum Role{
  ADMIN
  SALES
}

enum FunnelStage {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum ContactType {
  EMAIL
  CALL
  WHATSAPP
  MEETING
  SYSTEM_CHANGE
  NOTE
}